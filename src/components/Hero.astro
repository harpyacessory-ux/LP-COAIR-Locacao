---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2). Grid desktop: texto (1fr) · coluna VAZIA (270px) · shortcode (300px).
 * A coluna 2 é a janela do banner; nunca coloque conteúdo nela.
 * Nesta LP a foto vai do fim do texto até a borda da tela (sem véu à direita): os 3 compressores
 * ocupam as colunas 2 e 3, e o chat do shortcode fica por cima da foto.
 * Abra a página com `?grid=1` para ver as colunas e a caixa da foto.
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'
import { hero } from '../data/content'

const isDev = import.meta.env.DEV

// Divide o H1 para pintar o trecho de destaque sem duplicar o texto em content.ts
const [titleBefore, ...titleRest] = hero.title.split(hero.highlight)
const titleAfter = titleRest.join(hero.highlight)
const hasHighlight = titleRest.length > 0
---

<section
  class="relative overflow-hidden rounded-b-3xl border-b border-white/15 bg-primary-dark-900 lg:rounded-b-[40px]"
  data-hero
>
  {/* z1 — banner: do fim do texto até a borda direita da tela (desktop), com entrada suave */}
  <div class="hero-photo absolute inset-0 z-[1]">
    <Picture
      src={hero.banner.src}
      alt={hero.banner.alt}
      widths={[640, 1024, 1536, 1981]}
      sizes="(min-width: 1024px) 62vw, 100vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[72%_center] lg:object-left"
      pictureAttributes={{
        class:
          'block h-full w-full lg:[mask-image:linear-gradient(to_right,transparent,black_100px)]',
      }}
    />
  </div>

  {/* z2 — véu navy sob o texto (liso, como na referência aprovada) */}
  <div class="hero-navy pointer-events-none absolute inset-y-0 left-0 z-[2] w-full"></div>

  {/* z5 — conteúdo */}
  <div class="relative z-[5] mx-auto max-w-page px-6 py-20 lg:px-10 lg:py-24">
    <div class="hero-grid grid items-center gap-y-12 lg:gap-x-6">
      {/* Coluna 1 — textos */}
      <div class="max-w-xl lg:max-w-none">
        <Eyebrow tone="light" accent="green">
          {hero.eyebrow}
        </Eyebrow>

        <h1 class="mt-3 font-display text-[2.75rem] leading-[1.1] font-extrabold text-neutral-light sm:text-[3rem] lg:text-[2.75rem] xl:text-[3.1rem]">
          {hasHighlight ? (
            <>
              {titleBefore}
              {/* Destaque sem quebra: "em operação" desce inteiro e não avança sobre o CA11 da foto */}
              <span class="whitespace-nowrap text-brand-green">{hero.highlight}</span>
              {titleAfter}
            </>
          ) : (
            hero.title
          )}
        </h1>

        <p class="mt-5 font-sans text-lg leading-snug font-medium text-neutral-light/80 lg:max-w-[31rem] lg:leading-normal">
          {hero.text}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-9 gap-y-4">
          <Button cta="hero-primary" variant="brand">
            {hero.ctaPrimary}
          </Button>
          <Button cta="hero-secondary" variant="link-light" icon={false}>
            {hero.ctaSecondary}
          </Button>
        </div>

        {/* 3 destaques — texto sempre em duas linhas, separados por divisórias */}
        <ul class="hero-points mt-10 flex flex-wrap gap-x-5 gap-y-4 sm:flex-nowrap">
          {hero.points.map((point) => (
            <li class="hero-point flex items-center gap-3">
              <Icon name={point.icon} class="size-7 shrink-0 text-neutral-light" />
              <span class="font-sans text-[13px] leading-snug font-medium text-neutral-light/85">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      {/* Coluna 2 — VAZIA de propósito: janela do banner */}
      <div class="hidden lg:block" aria-hidden="true"></div>

      {/* Coluna 3 — shortcode do chat (300px) */}
      <div
        class:list={[
          'w-full lg:w-[300px]',
          isDev &&
            Astro.slots.has('shortcode') &&
            'flex min-h-[430px] flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-white/40 bg-primary-dark-900/85 p-6 text-center font-mono text-xs text-white/70 backdrop-blur-sm',
        ]}
      >
        {isDev && Astro.slots.has('shortcode') && (
          <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-brand-green uppercase">
            Formulário · 300px
          </span>
        )}
        <slot name="shortcode">
          {isDev ? (
            <div
              class="flex min-h-[430px] w-full flex-col gap-3 rounded-lg border border-white/15 bg-neutral-light p-4 text-left"
              aria-label="Mock do chat (só em desenvolvimento)"
            >
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                Mock · chat
              </span>
              <p class="font-display text-base font-bold text-ink">Fale com um especialista</p>
              <div class="h-10 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="h-10 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="h-10 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="h-24 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="mt-auto h-11 rounded bg-accent-orange/80" />
            </div>
          ) : (
            <div class="flex min-h-[430px] w-full flex-col items-center justify-center gap-3 border border-dashed border-neutral-light/35 bg-primary-dark-900/80 p-6 text-center backdrop-blur-sm">
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                Espaço reservado
              </span>
              <p class="font-display text-lg font-bold text-neutral-light">Shortcode — 300px</p>
            </div>
          )}
        </slot>
      </div>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="hero-photo absolute inset-0 border-l-2 border-dashed border-accent-orange bg-accent-orange/5">
      <span class="absolute bottom-3 left-3 font-mono text-[11px] font-bold whitespace-nowrap text-accent-orange">
        foto · fim do texto → borda da tela
      </span>
    </div>
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-6">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-accent-orange lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-accent-orange">
            col 2 · 270px · vazia
          </span>
        </div>
        <div class="hidden border-x border-dashed border-white/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 300px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Divisórias sutis entre os destaques do hero (a partir de tablet) */
  @media (width >= 40rem) {
    .hero-point + .hero-point {
      padding-left: 1.25rem;
      border-left: 1px solid rgb(255 255 255 / 0.18);
    }
  }

  @media (width >= 64rem) {
    .hero-point + .hero-point {
      padding-left: 1.5rem;
    }
  }

  /* Metade da largura da página (1320px / 2): ancora as colunas e a foto no mesmo eixo. */
  .hero-photo,
  .hero-navy,
  .hero-grid {
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
  }

  .hero-navy {
    background:
      radial-gradient(1100px 520px at 12% -8%, rgb(255 255 255 / 0.1) 0%, transparent 55%),
      linear-gradient(
        to right,
        var(--color-primary-dark) 0%,
        var(--color-primary-dark-800) 55%,
        transparent 96%
      );
  }

  @media (min-width: 1024px) {
    /* Col 1 (1fr) | Col 2 janela do banner | Col 3 shortcode 300px */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 270px 300px;
    }

    /* Fim do bloco de texto: borda da página + padding + coluna 1, limitada a 31rem (largura do subtítulo). */
    /* 698px = padding (2 × 40) + coluna 2 (270) + coluna 3 (300) + gaps (2 × 24). */
    .hero-photo,
    .hero-navy {
      --text-end: calc(var(--page-edge) + 2.5rem + min(31rem, 100% - 2 * var(--page-edge) - 698px));
    }

    /* A foto começa 80px antes do fim do texto (a máscara do <picture> faz a entrada) e vai até a borda da tela. */
    /* Com a foto em 1,46:1, o CA11 encosta no fim do texto e o HD55 termina perto da borda. */
    .hero-photo {
      left: calc(var(--text-end) - 80px);
    }

    /* Navy sólido sob o texto, dissolvendo até o fim dele (o CA11 fica fora do véu). */
    .hero-navy {
      width: calc(var(--text-end) + 10px);
      background:
        radial-gradient(900px 520px at 10% -10%, rgb(255 255 255 / 0.08) 0%, transparent 55%),
        linear-gradient(
          to left,
          transparent 0px,
          rgb(0 33 71 / 0.7) 60px,
          var(--color-primary-dark) 130px
        );
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
